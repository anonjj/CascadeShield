# Maven build artifacts
**/target/
**/*.jar
**/*.war
**/*.class

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Experiment data (large files, generated).
# Ignore everything under data/ by default, then re-include the tracked reference and
# dataset files. NOTE: we ignore `data/*` (the contents), NOT `data/` (the dir) — git will
# not descend into an ignored directory, so file-level negations only work this way. The
# bare `*.csv` line was removed on purpose: negations must come after anything that would
# otherwise match, and a global `*.csv` re-shadowed these files. Keep canary output ignored.
data/*
data/canary_runs.csv
!data/DATA_DICTIONARY.md
!data/experiment_matrix.csv
!data/master_dataset_schema.csv
!data/master_dataset_v1_prefix.csv
!data/master_dataset_v2_latency_5svc.csv
!data/master_dataset.csv

# Generated figure artifact (was previously covered by the now-removed bare *.csv)
figures/summary_stats.csv

# Generated model artifacts. Regenerated by `python ml/train_all.py`, never a source of
# truth. These were tracked until the bundle silently went stale: it had been pickled
# against an older topology vocabulary (LINEAR_CHAIN) and raised ValueError on every
# recommend() call, while the committed .pkl kept looking current in review. Untracking
# them removes the stale-binary-in-git failure mode; ml/test_smoke.py catches the drift.
ml/models/*.pkl
ml/models/decision_tree_rules.txt
ml/recommended.env

# Environment overrides
.env

# Claude CLI
.claude/
logs/
experiments/logs/

# Self-test artifacts from analysis/canary_readout.py --self-test. Synthetic data; kept out
# of the repo so a watermarked placeholder can never be mistaken for a result.
figures/SELFTEST_*
analysis/out/selftest_*

# Day-2 canary run list is a design artifact, not collected data -- track it despite data/*.
!data/canary_matrix.csv
