# Maven build artifacts
**/target/
**/*.jar
**/*.war
**/*.class

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Experiment data (large files, generated).
# Ignore everything under data/ by default, then re-include the tracked reference and
# dataset files. NOTE: we ignore `data/*` (the contents), NOT `data/` (the dir) — git will
# not descend into an ignored directory, so file-level negations only work this way. The
# bare `*.csv` line was removed on purpose: negations must come after anything that would
# otherwise match, and a global `*.csv` re-shadowed these files. Keep canary output ignored.
data/*
data/canary_runs.csv
data/occupancy_dataset.csv
!data/DATA_DICTIONARY.md
!data/experiment_matrix.csv
!data/master_dataset_schema.csv
!data/master_dataset_v1_prefix.csv
!data/master_dataset_v2_latency_5svc.csv
!data/master_dataset_v4_flat_concurrency.csv
!data/master_dataset_v5_soham_linear_presweep.csv
!data/master_dataset_v6_pre_d17_leg_blend_crash.csv
# D21 poll-until-transition fix verification -- standalone, deliberately never merged
# into master_dataset.csv (see analysis/common.py's DATASETS entry for why: every
# (experiment_id, replicate) key here collides with rows already in 'current').
!data/master_dataset_d21_recollect.csv
# CB state-transition sidecar: the only source for D13's precise HALF_OPEN->CLOSED
# metric. Left untracked until now, which is exactly why D13 sat at n=1 -- the file was
# collected twice and lost twice. Tracked from here on.
!data/cb_transitions.jsonl
!data/master_dataset_calibration_*.csv
!data/master_dataset.csv
# Phase 4B (H3 post-D25 re-collection, 2026-09-21). The 72-row dataset, the
# independent gateway poll log, the launch manifest and the PID file are the whole
# product of a 2h39m collection and every verification view depends on all four.
# Tracked for the same reason cb_transitions.jsonl above is: an untracked artifact
# of a long run is one lost laptop away from being collected a third time.
!data/phase4b_postd25.csv
# data/audit is matched by `data/*` above, and git does not descend into an ignored
# DIRECTORY -- so re-including files inside it needs the same two-step the note at the
# top of this block describes: un-ignore the directory, re-ignore its contents, then
# negate the specific files. Everything else under data/audit/ (canary evidence,
# quarantine snapshots, the sidecar baseline, power-sim scratch) stays ignored.
!data/audit/
data/audit/*
!data/audit/phase4b_poll.jsonl
!data/audit/phase4b_manifest.json
!data/audit/phase4b_pids.txt

# Generated figure artifact (was previously covered by the now-removed bare *.csv)
figures/summary_stats.csv

# Generated model artifacts. Regenerated by `python ml/train_all.py`, never a source of
# truth. These were tracked until the bundle silently went stale: it had been pickled
# against an older topology vocabulary (LINEAR_CHAIN) and raised ValueError on every
# recommend() call, while the committed .pkl kept looking current in review. Untracking
# them removes the stale-binary-in-git failure mode; ml/test_smoke.py catches the drift.
ml/models/*.pkl
ml/models/decision_tree_rules.txt
ml/recommended.env

# Environment overrides
.env

# Claude CLI
.claude/
logs/
experiments/logs/

# Self-test artifacts from analysis/canary_readout.py --self-test. Synthetic data; kept out
# of the repo so a watermarked placeholder can never be mistaken for a result.
figures/SELFTEST_*
analysis/out/selftest_*

# Day-2 canary run list is a design artifact, not collected data -- track it despite data/*.
!data/canary_matrix.csv
